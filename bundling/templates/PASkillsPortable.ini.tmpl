; PASkillsPortable.ini - PortableApps.com Launcher config.
; Rendered by bundling/build.py; placed at App\AppInfo\Launcher\.

[Launch]
ProgramExecutable=PASkills\pa_skills.exe
WorkingDirectory=%PAL:DataDir%
WaitForProgram=true
SinglePortableAppInstance=true
; Splash shown while the app starts, from App\AppInfo\Launcher\splash.jpg
; (staged by build.py). This USED to be a purely timed overlay -- newadvsplash
; takes a duration and nothing told it the app was ready -- which meant this
; value had to double as an estimate of startup time: too low and it cleared
; into a blank desktop, too high and a topmost splash parked itself on top of
; an already-usable window. Neither failure was avoidable with a single
; number, because a fixed duration necessarily encodes ONE machine's hardware
; and ships it to every machine that runs the app.
; That estimate role is gone. ui/_splash.py now dismisses this window itself,
; the moment the app's real window fires pywebview's `shown` event, by
; synthesizing the mouse click that the newadvsplash plugin already treats as
; "dismiss" (see SplashScreen.nsh -- it is invoked without /NOCANCEL). So
; SplashTime is no longer an estimate to land close to; it is a MAXIMUM, and
; every run that isn't the slowest one on record ends the splash early
; regardless of what this number says.
; Reference measurements (frozen exe, not source -- source mode is markedly
; faster): launcher start to a visible window was 11.77s warm and 44.0s cold.
; Both of those undercount the true splash-visible duration by about 1.3s,
; because the splash does not appear at launcher start (t=0) -- the launcher
; does its own work first -- so every value ever tuned against "time to
; visible window" was implicitly ~1.3s more generous than the number suggests.
; Cold starts used to be deliberately left uncovered, because stretching the
; timer to cover them would park a topmost splash over a usable window on
; every warm run. That trade-off no longer exists once dismissal is
; event-driven rather than timed, so this is now set to comfortably clear the
; measured 44s cold start, confident that ui/_splash.py will cut it short on
; every faster run instead.
; This all depends on PAL continuing to launch newadvsplash without
; /NOCANCEL. If a future PAL version adds it, ui/_splash.py's click will
; simply stop landing (it already no-ops silently on any failure), the splash
; will run the full duration below on every single run, and this value needs
; to come back down to something warm-start-sized again.
; LaunchAppAfterSplash is intentionally NOT set: it would run the splash to
; completion BEFORE starting the app, adding the duration instead of hiding it.
; A missing App\AppInfo\Launcher\splash.jpg silently sets DisableSplashScreen
; to true (see bundling/build.py) -- the app then starts with no splash at
; all rather than failing, so a build with the splash asset dropped will not
; surface as an error here.
SplashTime=45000

[Activate]
Registry=false
RegistryValueWrite=false

[FileWrite]
Base=%PAL:DataDir%

[DirectoriesCleanupIfEmpty]
1=%PAL:DataDir%\settings
2=%PAL:DataDir%\outputs
3=%PAL:DataDir%\logs

[FilesMove]
; (none; first-run copy of DefaultData -> Data is handled by PAL automatically)

[Language]
Base=ENGLISH
